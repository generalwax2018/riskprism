# The app reads real environment variables only (it does not load a .env file).
# Use this as a checklist: export them in your shell, put them in a systemd EnvironmentFile,
# or set them as App Service application settings.
# Nothing here is required for a laptop run: defaults bind 127.0.0.1 with no login.

# --- Where data lives ---------------------------------------------------------
# App Service on Linux: /home is persistent, so use /home/entropy-data.
ENTROPY_DATA_DIR=./data

# --- Network ------------------------------------------------------------------
ENTROPY_HOST=127.0.0.1
ENTROPY_PORT=8765
# Public URL vendors see in magic links, no trailing slash. Set this in Azure.
# ENTROPY_BASE_URL=https://tprm.example.com
# Extra Host header values to accept (comma separated). Needed only when bound to loopback behind a proxy.
# ENTROPY_ALLOWED_HOSTS=tprm.example.com

# --- Analyst sign-in ------------------------------------------------------------
# none      loopback only. The server refuses to bind anything else.
# accounts  one login per person: email + password + authenticator app. Use this for a team.
#           First admin: python accounts.py invite you@example.com --admin
# password  one shared password, session cookie, throttled login (12+ characters). Demos only.
# easyauth  Azure App Service authentication (Entra ID). The platform signs the user in.
ENTROPY_AUTH=none
# ENTROPY_ANALYST_PASSWORD=
# Optional allow-list for easyauth (comma separated sign-in names). Empty = any user the platform lets in.
# ENTROPY_ALLOWED_USERS=ana@example.com,ben@example.com
# Signs sessions, CSRF tokens and audit log seals, and encrypts authenticator secrets.
# If unset, one is generated and kept in DATA_DIR/secret.key. Do not rotate it casually: older audit
# entries stop verifying and everyone has to set up their authenticator again.
# ENTROPY_SECRET=

# --- Vendor links -------------------------------------------------------------------
ENTROPY_TOKEN_DAYS=30

# Risk acceptance: who may edit org units and approvers, and the longest an acceptance may run
# ENTROPY_ADMINS=ciso@example.com
# ENTROPY_ACCEPT_MAX_DAYS=365

# View-only people (comma separated sign-in names): can open every page and download exports, cannot change anything.
# Meant for easyauth; in accounts mode use "Make view-only" on the People page instead. Wins over ENTROPY_ADMINS.
# ENTROPY_VIEWERS=auditor@example.com

# --- Analyst single sign-on (accounts mode only) --------------------------------------------
# Redirect URI to register with the provider: <ENTROPY_BASE_URL>/login/sso/callback
# ENTROPY_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTROPY_OIDC_CLIENT_ID=
# ENTROPY_OIDC_CLIENT_SECRET=
# ENTROPY_OIDC_LABEL=Sign in with Microsoft
# ENTROPY_OIDC_ONLY=1                 # no password sign-in at all
# ENTROPY_OIDC_EMAIL_CLAIM=email      # default: email, then preferred_username, then upn

# --- Tickets from the findings worklist (optional) ------------------------------------------
# ENTROPY_SNOW_INSTANCE=https://yourco.service-now.com
# ENTROPY_SNOW_USER=
# ENTROPY_SNOW_PASSWORD=
# ENTROPY_SNOW_TABLE=incident
# ENTROPY_SNOW_GROUP=
# ENTROPY_JIRA_URL=https://yourco.atlassian.net
# ENTROPY_JIRA_EMAIL=
# ENTROPY_JIRA_TOKEN=
# ENTROPY_JIRA_PROJECT=SEC
# ENTROPY_JIRA_ISSUETYPE=Task
# ENTROPY_JIRA_DUEDATE=1              # send the finding's due date (the project's create screen must have Due date)

# --- Email (optional; off until ENTROPY_SMTP_HOST is set) ----------------------------------
# Sends vendor questionnaire links, invite links and a weekly digest. Plain text, no tracking.
# ENTROPY_SMTP_HOST=smtp.office365.com
# ENTROPY_SMTP_PORT=587
# ENTROPY_SMTP_TLS=starttls           # starttls | ssl (port 465) | none (only for a mail server on this machine)
# ENTROPY_SMTP_USER=
# ENTROPY_SMTP_PASSWORD=              # a secret, keep it out of git; never written to disk or the audit log
# ENTROPY_SMTP_FROM=Acme Security <security@acme.example>   # required when ENTROPY_SMTP_HOST is set
# ENTROPY_DIGEST=weekly               # weekly (default when email is on) | off. Monday after 08:00 server time
# ENTROPY_DIGEST_TO=ciso@example.com  # extra recipients; active admins get it in accounts mode

# --- Backups ------------------------------------------------------------------------------
# A .tar.gz of the data folder every night after 02:00 server time. secret.key is NOT included:
# keep a copy of it somewhere separate (Key Vault, a password manager).
# ENTROPY_BACKUP=daily                # daily (default) | off
# ENTROPY_BACKUP_DIR=/mnt/riskprism-backups   # default DATA_DIR/backups; use a mounted Azure Files share or another disk
# ENTROPY_BACKUP_KEEP=14

# --- AI switch ---------------------------------------------------------------------------
# off: no AI controls, no model calls, no vendor website fetches, even when LLM_* is set below.
# ENTROPY_AI=off

# --- AI model (any provider that speaks the OpenAI chat-completions format) -----------
# Vendor pages and analyst notes are sent to this provider. Keep the key out of git.
# Grok only: XAI_API_KEY alone is enough (base URL defaults to https://api.x.ai/v1).
# XAI_API_KEY=
# XAI_MODEL=grok-4
# Any other provider (these win over the XAI_* names):
# LLM_BASE_URL=https://api.openai.com/v1      # or https://openrouter.ai/api/v1, http://127.0.0.1:11434/v1 (Ollama)
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1
# LLM_TIMEOUT=180

# --- Evidence in Azure Blob (optional; needs: pip install azure-storage-blob azure-identity) --------
# Preferred: managed identity with the Storage Blob Data Contributor role.
# ENTROPY_AZURE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# ENTROPY_AZURE_CONTAINER=evidence
# Fallback: connection string (a secret, keep it out of git).
# ENTROPY_AZURE_CONNECTION=

# --- Development only -----------------------------------------------------------------
# ENTROPY_ALLOW_SEED=1       show "Load sample clocks" outside no-auth mode
# ENTROPY_ALLOW_INSECURE=1   bind a non-loopback address with no login (do not use on a network)
